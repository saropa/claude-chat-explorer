{
    "files.watcherExclude": {
        ".git/objects/**": true,
        ".git/subtree-cache/**": true,
        ".hg/store/**": true,
        "*/.git/objects/**": true,
        "*/.git/subtree-cache/**": true,
        "*/.hg/store/**": true,
        "**/.dart_tool": true,
        "**/.widget_preview": true,
        "**/.dart_tool/**": true,
        "**/build/**": true,
        "**/reports/**": true,
        "**/.dev/**": true,
        "**/dependency_overrides/**": true,
        "**/ios/Runner/**": true,
        "**/android/flutter_code/**": true,
        "**/*.hprof": true,
        "**/*.log": true,
        "**/.vs/**": true,
        "**/dependency_overrides/**/build/**": true,
        "**/dependency_overrides/**/.dart_tool/**": true,
        "**/.gradle/**": true,
        "**/android/build/**": true,
        "**/android/app/build/**": true,
        "**/ios/build/**": true,
        "**/ios/Pods/**": true,
        "**/ios/.symlinks/**": true,
        "**/DerivedData/**": true
    }
}
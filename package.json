{
  "name": "claude-chat-search",
  "displayName": "Saropa Chat Search",
  "description": "Full-text search of Claude Code chats from the activity bar.",
  "version": "0.0.6",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/saropa/claude-chat-search.git"
  },
  "publisher": "local",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "claudeChatSearch",
          "title": "Saropa Chat Search",
          "icon": "icon.svg"
        }
      ]
    },
    "views": {
      "claudeChatSearch": [
        {
          "type": "webview",
          "id": "claudeChatSearch.view",
          "name": "Saropa Chat Search",
          "icon": "icon.svg"
        }
      ]
    }
  },
  "scripts": {
    "compile": "tsc -p .",
    "package": "npx @vscode/vsce package --allow-missing-repository --skip-license"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.90.0",
    "typescript": "^5.4.0"
  }
}

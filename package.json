{
  "name": "claude-chat-search",
  "displayName": "Saropa Chat Search",
  "description": "Full-text search of Claude Code chats from the activity bar.",
  "version": "0.7.1",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/saropa/claude-chat-search.git"
  },
  "publisher": "local",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "claudeChatSearch",
          "title": "Saropa Chat Search",
          "icon": "icon.svg"
        },
        {
          "id": "claudeChatSearch.gitContainer",
          "title": "Saropa Git Activity",
          "icon": "gitIcon.svg"
        }
      ]
    },
    "views": {
      "claudeChatSearch": [
        {
          "type": "webview",
          "id": "claudeChatSearch.view",
          "name": "Saropa Chat Search",
          "icon": "icon.svg"
        }
      ],
      "claudeChatSearch.gitContainer": [
        {
          "id": "claudeChatSearch.git",
          "name": "Git Activity",
          "icon": "icon.svg"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "claudeChatSearch.git",
        "contents": "No git activity found in your chats yet."
      }
    ],
    "commands": [
      {
        "command": "claudeChatSearch.clearHistory",
        "title": "Saropa Chat Search: Clear Search History"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "claudeChatSearch.clearHistory",
          "when": "view == claudeChatSearch.view"
        }
      ]
    }
  },
  "scripts": {
    "compile": "tsc -p .",
    "package": "npx @vscode/vsce package --allow-missing-repository --skip-license"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.90.0",
    "typescript": "^5.4.0"
  }
}

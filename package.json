{
  "name": "claude-chat-explorer",
  "displayName": "Saropa Chat Explorer",
  "description": "Search your AI agent session history in VS Code: full-text search of every session, including subagents, then resume the session you find.",
  "version": "0.40.0",
  "icon": "images/icon.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/saropa/claude-chat-explorer.git"
  },
  "publisher": "saropa",
  "bugs": {
    "url": "https://github.com/saropa/claude-chat-explorer/issues"
  },
  "homepage": "https://github.com/saropa/claude-chat-explorer#readme",
  "galleryBanner": {
    "color": "#1e1e1e",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "agent",
    "ai-agent",
    "session history",
    "search",
    "explorer",
    "session",
    "resume",
    "conversation",
    "transcript",
    "subagent",
    "ai"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "claudeChatExplorer",
          "title": "Saropa Chat Explorer",
          "icon": "icon.svg"
        }
      ]
    },
    "views": {
      "claudeChatExplorer": [
        {
          "type": "webview",
          "id": "claudeChatExplorer.view",
          "name": "Saropa Chat Explorer",
          "icon": "icon.svg"
        }
      ]
    },
    "commands": [
      {
        "command": "saropaChatExplorer.claudeConfig",
        "title": "Saropa Chat Explorer: Claude Config"
      },
      {
        "command": "saropaChatExplorer.options",
        "title": "Saropa Chat Explorer: Options"
      },
      {
        "command": "saropaChatExplorer.usageSummary",
        "title": "Saropa: Usage Summary"
      },
      {
        "command": "saropaChatExplorer.usageBar.show",
        "title": "Saropa: Show Nearly Full Sessions"
      },
      {
        "command": "saropaChatExplorer.archiveTiny",
        "title": "Saropa: Archive Empty and Tiny Sessions"
      },
      {
        "command": "saropaChatExplorer.regenTitles",
        "title": "Saropa Chat Explorer: Regenerate Session Titles",
        "icon": "$(sparkle)"
      },
      {
        "command": "saropaChatExplorer.autoTitleOn",
        "title": "Auto-title sessions"
      },
      {
        "command": "saropaChatExplorer.autoTitleOff",
        "title": "$(check) Auto-title sessions"
      },
      {
        "command": "saropaChatExplorer.copyResume",
        "title": "Saropa: Copy Resume Command"
      },
      {
        "command": "saropaChatExplorer.exportChatMarkdown",
        "title": "Saropa: Export Session as Markdown"
      },
      {
        "command": "claudeChatExplorer.openWork",
        "title": "Saropa Chat Explorer: Project Status",
        "icon": "$(checklist)"
      },
      {
        "command": "claudeChatExplorer.searchTips",
        "title": "Saropa Chat Explorer: Search Tips",
        "icon": "$(info)"
      },
      {
        "command": "claudeChatExplorer.sortResults",
        "title": "Saropa Chat Explorer: Sort Results",
        "icon": "$(sort-precedence)"
      },
      {
        "command": "claudeChatExplorer.filterStatus",
        "title": "Saropa Chat Explorer: Filter by Status",
        "icon": "$(filter)"
      },
      {
        "command": "saropaChatExplorer.fileSessions.show",
        "title": "Saropa: Find Related Sessions"
      },
      {
        "command": "claudeChatExplorer.clearHistory",
        "title": "Saropa Chat Explorer: Clear Search History"
      },
      {
        "command": "saropaChatExplorer.openResultsInEditor",
        "title": "Saropa Chat Explorer: Open Results in Editor"
      },
      {
        "command": "saropaChatExplorer.importArchived",
        "title": "Saropa Chat Explorer: Import Archived Sessions from the Agent"
      },
      {
        "command": "saropaChatExplorer.diagnostics",
        "title": "Saropa Chat Explorer: Show Diagnostics"
      },
      {
        "command": "saropaChatExplorer.archive",
        "title": "Archive Session"
      },
      {
        "command": "saropaChatExplorer.unarchive",
        "title": "Unarchive Session"
      },
      {
        "command": "saropaChatExplorer.pin",
        "title": "Pin Session"
      },
      {
        "command": "saropaChatExplorer.unpin",
        "title": "Unpin Session"
      },
      {
        "command": "saropaChatExplorer.markRead",
        "title": "Mark as Read"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "saropaChatExplorer.fileSessions.show",
          "when": "resourceScheme == file && !explorerResourceIsFolder",
          "group": "saropaChatExplorer@1"
        }
      ],
      "editor/context": [
        {
          "command": "saropaChatExplorer.fileSessions.show",
          "when": "resourceScheme == file",
          "group": "saropaChatExplorer@1"
        }
      ],
      "editor/title/context": [
        {
          "command": "saropaChatExplorer.fileSessions.show",
          "when": "resourceScheme == file",
          "group": "saropaChatExplorer@1"
        }
      ],
      "view/title": [
        {
          "command": "claudeChatExplorer.searchTips",
          "when": "view == claudeChatExplorer.view",
          "group": "navigation@1"
        },
        {
          "command": "claudeChatExplorer.sortResults",
          "when": "view == claudeChatExplorer.view",
          "group": "navigation@2"
        },
        {
          "command": "claudeChatExplorer.openWork",
          "when": "view == claudeChatExplorer.view",
          "group": "navigation"
        },
        {
          "command": "saropaChatExplorer.regenTitles",
          "when": "view == claudeChatExplorer.view",
          "group": "navigation@4"
        },
        {
          "command": "saropaChatExplorer.autoTitleOn",
          "when": "view == claudeChatExplorer.view && !saropaChatExplorer.autoTitleEnabled"
        },
        {
          "command": "saropaChatExplorer.autoTitleOff",
          "when": "view == claudeChatExplorer.view && saropaChatExplorer.autoTitleEnabled"
        },
        {
          "command": "saropaChatExplorer.claudeConfig",
          "when": "view == claudeChatExplorer.view"
        },
        {
          "command": "saropaChatExplorer.options",
          "when": "view == claudeChatExplorer.view"
        },
        {
          "command": "claudeChatExplorer.clearHistory",
          "when": "view == claudeChatExplorer.view"
        }
      ],
      "webview/context": [
        {
          "command": "saropaChatExplorer.copyResume",
          "when": "webviewId == 'claudeChatExplorer.view' && webviewSection == 'chat'",
          "group": "saropaChatExplorer@3"
        },
        {
          "command": "saropaChatExplorer.exportChatMarkdown",
          "when": "webviewId == 'claudeChatExplorer.view' && webviewSection == 'chat'",
          "group": "saropaChatExplorer@4"
        },
        {
          "command": "saropaChatExplorer.archive",
          "when": "webviewId == 'claudeChatExplorer.view' && webviewSection == 'chat' && !ccsArchived",
          "group": "saropaChatExplorer@1"
        },
        {
          "command": "saropaChatExplorer.unarchive",
          "when": "webviewId == 'claudeChatExplorer.view' && webviewSection == 'chat' && ccsArchived",
          "group": "saropaChatExplorer@1"
        },
        {
          "command": "saropaChatExplorer.pin",
          "when": "webviewId == 'claudeChatExplorer.view' && webviewSection == 'chat' && !ccsPinned",
          "group": "saropaChatExplorer@1"
        },
        {
          "command": "saropaChatExplorer.unpin",
          "when": "webviewId == 'claudeChatExplorer.view' && webviewSection == 'chat' && ccsPinned",
          "group": "saropaChatExplorer@1"
        },
        {
          "command": "saropaChatExplorer.markRead",
          "when": "webviewId == 'claudeChatExplorer.view' && webviewSection == 'chat' && ccsUnread",
          "group": "saropaChatExplorer@2"
        }
      ],
      "commandPalette": [
        {
          "command": "saropaChatExplorer.autoTitleOn",
          "when": "false"
        },
        {
          "command": "saropaChatExplorer.autoTitleOff",
          "when": "false"
        },
        {
          "command": "saropaChatExplorer.copyResume",
          "when": "false"
        },
        {
          "command": "saropaChatExplorer.exportChatMarkdown",
          "when": "false"
        },
        {
          "command": "saropaChatExplorer.usageBar.show",
          "when": "false"
        },
        {
          "command": "saropaChatExplorer.archive",
          "when": "false"
        },
        {
          "command": "saropaChatExplorer.unarchive",
          "when": "false"
        },
        {
          "command": "saropaChatExplorer.pin",
          "when": "false"
        },
        {
          "command": "saropaChatExplorer.unpin",
          "when": "false"
        },
        {
          "command": "saropaChatExplorer.markRead",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "Saropa Chat Explorer",
      "properties": {
        "saropaChatExplorer.webSessions.enabled": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Show Claude Code Web (cloud) sessions in a Web tab. Uses an unofficial, undocumented Anthropic API with your Claude Code login token (read-only; never stored or logged). It may break or change without notice. Off by default: when off, no network call and no credential read is made."
        },
        "saropaChatExplorer.showFileSessionsStatusBar": {
          "type": "boolean",
          "default": true,
          "description": "Show a status bar count of the sessions that touched the active file."
        },
        "saropaChatExplorer.showUsageStatusBar": {
          "type": "boolean",
          "default": true,
          "description": "Show a status bar item with the number of sessions whose context is 80 percent full or more (hidden when there are none). Click it to list those sessions in the panel."
        },
        "saropaChatExplorer.contextWarnings": {
          "type": "boolean",
          "default": true,
          "description": "Show a notification when a live session reaches 80 and 90 percent of its context window. The 90 percent notification also offers Copy hand-over note."
        },
        "saropaChatExplorer.maxResults": {
          "type": "number",
          "default": 500,
          "minimum": 50,
          "maximum": 2000,
          "description": "The most sessions listed in search results and in All sessions. Sessions beyond it are still counted, and the panel says so."
        },
        "saropaChatExplorer.openWorkDays": {
          "type": "number",
          "default": 14,
          "minimum": 1,
          "maximum": 90,
          "description": "How many days of sessions the Project Status page lists. Sessions that are open now are always listed. Archived sessions are left out."
        },
        "saropaChatExplorer.lookupPullRequests": {
          "type": "boolean",
          "default": true,
          "description": "Look up open pull requests and their check results (passing, failing, pending) for the Git section of a session card and for the Project Status page, with the gh command (GitHub CLI). This contacts GitHub using your own gh sign-in. Turn it off to never run gh."
        },
        "saropaChatExplorer.autoTitle.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Name new Claude Code sessions automatically: an emoji for the topic plus the first sentence of your first prompt, renamed once after your third prompt. Works in the background from the session file; a session you already named yourself is left alone."
        },
        "saropaChatExplorer.autoTitle.useHaiku": {
          "type": "boolean",
          "default": false,
          "description": "Let the claude command (Haiku model) write the automatic session title and emoji instead of the rules. Runs in the background and starts a claude process; if it fails, the rule-based title is used. Only applies when automatic titles are on."
        },
        "saropaChatExplorer.emojiRules": {
          "type": "array",
          "default": [],
          "items": {
            "type": "object",
            "properties": {
              "emoji": {
                "type": "string",
                "description": "One emoji."
              },
              "keywords": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Whole words that choose this emoji; the emoji with the most matches wins."
              }
            },
            "required": [
              "emoji",
              "keywords"
            ]
          },
          "description": "Your own emoji rules for automatic session titles. A rule with the same emoji as a built-in one replaces that one's keywords; other rules are added and win ties."
        },
        "saropaChatExplorer.emojiRulesReplaceDefaults": {
          "type": "boolean",
          "default": false,
          "description": "Use only your emoji rules and ignore the built-in ones."
        },
        "saropaChatExplorer.contextRingTokens": {
          "type": "number",
          "default": 300000,
          "minimum": 10000,
          "description": "Each session row shows a small ring that fills as the session's context grows. This is the token count that fills it. The ring turns to the warning color at 80 percent of this number and to the error color at 100 percent or more."
        },
        "saropaChatExplorer.search.contextLines": {
          "type": "integer",
          "default": 1,
          "minimum": 1,
          "maximum": 4,
          "description": "How many lines of each matching message (the snippet and the extra matching messages) a search result row shows before cutting it off. Narrow side bars always show one line."
        },
        "saropaChatExplorer.animateDots": {
          "type": "boolean",
          "default": true,
          "description": "Animate the session dots: running, waiting and background dots throb, and a session with several states at once (for example background agents and unread) alternates between their colors. Turn it off for still dots that show the most important state; the tooltip lists them all. Dots are also still when your system asks for reduced motion."
        }
      }
    },
    "colors": [
      {
        "id": "saropaChatExplorer.dotRunning",
        "description": "Session dot: the agent is running.",
        "defaults": {
          "dark": "#89d185",
          "light": "#89d185",
          "highContrast": "#89d185",
          "highContrastLight": "#89d185"
        }
      },
      {
        "id": "saropaChatExplorer.dotWaiting",
        "description": "Session dot: the agent is waiting for you.",
        "defaults": {
          "dark": "#3b82f6",
          "light": "#3b82f6",
          "highContrast": "#3b82f6",
          "highContrastLight": "#3b82f6"
        }
      },
      {
        "id": "saropaChatExplorer.dotUnread",
        "description": "Session dot: finished while you were away.",
        "defaults": {
          "dark": "#d97757",
          "light": "#d97757",
          "highContrast": "#d97757",
          "highContrastLight": "#d97757"
        }
      },
      {
        "id": "saropaChatExplorer.dotBackground",
        "description": "Session dot: waiting on background agents or tasks that are still running.",
        "defaults": {
          "dark": "#b180d7",
          "light": "#b180d7",
          "highContrast": "#b180d7",
          "highContrastLight": "#b180d7"
        }
      },
      {
        "id": "saropaChatExplorer.dotIdle",
        "description": "Session dot: idle.",
        "defaults": {
          "dark": "#9d9d9d66",
          "light": "#61616166",
          "highContrast": "#9d9d9d66",
          "highContrastLight": "#61616166"
        }
      }
    ]
  },
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('out',{recursive:true,force:true})\"",
    "compile": "tsc -p .",
    "vscode:prepublish": "npm run clean && npm run compile && node scripts/check_manifest.js && node scripts/check_webview.js && node scripts/check_openwork.js && node scripts/check_scan.js && node scripts/check_prs.js && node scripts/check_prs_e2e.js && node scripts/check_guards.js && node scripts/check_dots.js && node scripts/check_regen.js && node scripts/check_autotitle.js && node scripts/check_autotitle_flag.js && node scripts/check_web.js && node scripts/check_options.js && node scripts/check_claude_config.js && node scripts/check_account.js && node scripts/check_tokens.js && node scripts/check_api.js",
    "package": "npx --yes @vscode/vsce package --allow-missing-repository --skip-license"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/vscode": "^1.90.0",
    "typescript": "^7.0.2"
  }
}

{
  "name": "claude-chat-explorer",
  "displayName": "Saropa Chat Explorer",
  "description": "Search Claude Code chat history in VS Code: full-text search of every session, including subagents, then resume the chat you find.",
  "version": "0.14.1",
  "icon": "images/icon.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/saropa/claude-chat-search.git"
  },
  "publisher": "saropa",
  "bugs": {
    "url": "https://github.com/saropa/claude-chat-search/issues"
  },
  "homepage": "https://github.com/saropa/claude-chat-search#readme",
  "galleryBanner": {
    "color": "#1e1e1e",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "claude",
    "claude-code",
    "anthropic",
    "chat history",
    "search",
    "explorer",
    "session",
    "resume",
    "conversation",
    "transcript",
    "subagent",
    "ai"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "claudeChatExplorer",
          "title": "Saropa Chat Explorer",
          "icon": "icon.svg"
        },
        {
          "id": "claudeChatExplorerGit",
          "title": "Saropa Git Activity",
          "icon": "gitIcon.svg"
        }
      ]
    },
    "views": {
      "claudeChatExplorer": [
        {
          "type": "webview",
          "id": "claudeChatExplorer.view",
          "name": "Saropa Chat Explorer",
          "icon": "icon.svg"
        }
      ],
      "claudeChatExplorerGit": [
        {
          "id": "claudeChatExplorer.git",
          "name": "Git Activity",
          "icon": "icon.svg"
        },
        {
          "id": "claudeChatExplorer.wip",
          "name": "Work in Progress",
          "icon": "icon.svg"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "claudeChatExplorer.git",
        "contents": "No git activity found in your chats yet."
      },
      {
        "view": "claudeChatExplorer.wip",
        "contents": "Nothing in progress. Chats with uncommitted files, unpushed commits, open PRs or a running session appear here."
      }
    ],
    "commands": [
      {
        "command": "saropaChatExplorer.fileSessions.show",
        "title": "Saropa: Chats That Touched This File"
      },
      {
        "command": "claudeChatExplorer.clearHistory",
        "title": "Saropa Chat Explorer: Clear Search History"
      },
      {
        "command": "saropaChatExplorer.importArchived",
        "title": "Saropa Chat Explorer: Import Archived Chats from Claude Code"
      },
      {
        "command": "saropaChatExplorer.diagnostics",
        "title": "Saropa Chat Explorer: Show Diagnostics"
      },
      {
        "command": "saropaChatExplorer.archive",
        "title": "Archive Chat"
      },
      {
        "command": "saropaChatExplorer.unarchive",
        "title": "Unarchive Chat"
      },
      {
        "command": "saropaChatExplorer.markRead",
        "title": "Mark as Read"
      },
      {
        "command": "saropaChatExplorer.wip.refresh",
        "title": "Saropa Chat Explorer: Refresh Work in Progress",
        "icon": "$(refresh)"
      },
      {
        "command": "saropaChatExplorer.wip.copySummary",
        "title": "Saropa Chat Explorer: Copy Work in Progress Summary"
      },
      {
        "command": "saropaChatExplorer.wip.groupByChat",
        "title": "Saropa Chat Explorer: Group by Chat",
        "toggled": {
          "condition": "saropaChatExplorer.wipGroup == 'chat'",
          "icon": "$(check)"
        }
      },
      {
        "command": "saropaChatExplorer.wip.groupByWorktree",
        "title": "Saropa Chat Explorer: Group by Worktree",
        "toggled": {
          "condition": "saropaChatExplorer.wipGroup == 'worktree'",
          "icon": "$(check)"
        }
      },
      {
        "command": "saropaChatExplorer.wip.showClean",
        "title": "Saropa Chat Explorer: Show Clean Chats",
        "toggled": {
          "condition": "saropaChatExplorer.wipClean",
          "icon": "$(check)"
        }
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "saropaChatExplorer.fileSessions.show",
          "when": "resourceScheme == file && !explorerResourceIsFolder",
          "group": "saropaChatExplorer@1"
        }
      ],
      "editor/context": [
        {
          "command": "saropaChatExplorer.fileSessions.show",
          "when": "resourceScheme == file",
          "group": "saropaChatExplorer@1"
        }
      ],
      "editor/title/context": [
        {
          "command": "saropaChatExplorer.fileSessions.show",
          "when": "resourceScheme == file",
          "group": "saropaChatExplorer@1"
        }
      ],
      "view/title": [
        {
          "command": "claudeChatExplorer.clearHistory",
          "when": "view == claudeChatExplorer.view"
        },
        {
          "command": "saropaChatExplorer.wip.refresh",
          "when": "view == claudeChatExplorer.wip",
          "group": "navigation@1"
        },
        {
          "command": "saropaChatExplorer.wip.copySummary",
          "when": "view == claudeChatExplorer.wip",
          "group": "1_actions@1"
        },
        {
          "command": "saropaChatExplorer.wip.groupByChat",
          "when": "view == claudeChatExplorer.wip",
          "group": "2_group@1"
        },
        {
          "command": "saropaChatExplorer.wip.groupByWorktree",
          "when": "view == claudeChatExplorer.wip",
          "group": "2_group@2"
        },
        {
          "command": "saropaChatExplorer.wip.showClean",
          "when": "view == claudeChatExplorer.wip",
          "group": "3_filter@1"
        }
      ],
      "webview/context": [
        {
          "command": "saropaChatExplorer.archive",
          "when": "webviewId == 'claudeChatExplorer.view' && webviewSection == 'chat' && !ccsArchived",
          "group": "saropaChatExplorer@1"
        },
        {
          "command": "saropaChatExplorer.unarchive",
          "when": "webviewId == 'claudeChatExplorer.view' && webviewSection == 'chat' && ccsArchived",
          "group": "saropaChatExplorer@1"
        },
        {
          "command": "saropaChatExplorer.markRead",
          "when": "webviewId == 'claudeChatExplorer.view' && webviewSection == 'chat' && ccsUnread",
          "group": "saropaChatExplorer@2"
        }
      ],
      "commandPalette": [
        {
          "command": "saropaChatExplorer.archive",
          "when": "false"
        },
        {
          "command": "saropaChatExplorer.unarchive",
          "when": "false"
        },
        {
          "command": "saropaChatExplorer.markRead",
          "when": "false"
        },
        {
          "command": "saropaChatExplorer.wip.groupByChat",
          "when": "false"
        },
        {
          "command": "saropaChatExplorer.wip.groupByWorktree",
          "when": "false"
        },
        {
          "command": "saropaChatExplorer.wip.showClean",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "Saropa Chat Explorer",
      "properties": {
        "saropaChatExplorer.showFileSessionsStatusBar": {
          "type": "boolean",
          "default": true,
          "description": "Show a status bar count of the Claude chats that touched the active file."
        },
        "saropaChatExplorer.contextWarnings": {
          "type": "boolean",
          "default": true,
          "description": "Show a notification when a live Claude chat reaches 80 and 90 percent of its context window."
        },
        "saropaChatExplorer.maxResults": {
          "type": "number",
          "default": 500,
          "minimum": 50,
          "maximum": 2000,
          "description": "The most chats listed in search results and in All sessions. Chats beyond it are still counted, and the panel says so."
        },
        "saropaChatExplorer.lookupPullRequests": {
          "type": "boolean",
          "default": true,
          "description": "Look up open pull requests for the Work in Progress view with the gh command (GitHub CLI). This contacts GitHub using your own gh sign-in. Turn it off to never run gh."
        },
        "saropaChatExplorer.workInProgressDays": {
          "type": "number",
          "default": 7,
          "minimum": 1,
          "maximum": 60,
          "description": "The Work in Progress view covers chats active in this many days, plus chats with a running Claude session."
        }
      }
    },
    "colors": [
      {
        "id": "saropaChatExplorer.dotRunning",
        "description": "Chat dot: Claude is running.",
        "defaults": {
          "dark": "#89d185",
          "light": "#89d185",
          "highContrast": "#89d185",
          "highContrastLight": "#89d185"
        }
      },
      {
        "id": "saropaChatExplorer.dotWaiting",
        "description": "Chat dot: Claude is waiting for you.",
        "defaults": {
          "dark": "#3b82f6",
          "light": "#3b82f6",
          "highContrast": "#3b82f6",
          "highContrastLight": "#3b82f6"
        }
      },
      {
        "id": "saropaChatExplorer.dotUnread",
        "description": "Chat dot: finished while you were away.",
        "defaults": {
          "dark": "#d97757",
          "light": "#d97757",
          "highContrast": "#d97757",
          "highContrastLight": "#d97757"
        }
      },
      {
        "id": "saropaChatExplorer.dotIdle",
        "description": "Chat dot: idle.",
        "defaults": {
          "dark": "#9d9d9d66",
          "light": "#61616166",
          "highContrast": "#9d9d9d66",
          "highContrastLight": "#61616166"
        }
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p .",
    "prepackage": "node scripts/check_manifest.js",
    "package": "npx @vscode/vsce package --allow-missing-repository --skip-license"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.90.0",
    "typescript": "^5.4.0"
  }
}

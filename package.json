{
  "name": "claude-chat-search",
  "displayName": "Saropa Chat Search",
  "description": "Search Claude Code chat history in VS Code: full-text search of every session, including subagents, then resume the chat you find.",
  "version": "0.11.0",
  "icon": "images/icon.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/saropa/claude-chat-search.git"
  },
  "publisher": "saropa",
  "bugs": {
    "url": "https://github.com/saropa/claude-chat-search/issues"
  },
  "homepage": "https://github.com/saropa/claude-chat-search#readme",
  "galleryBanner": {
    "color": "#1e1e1e",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "claude",
    "claude-code",
    "anthropic",
    "chat history",
    "search",
    "session",
    "resume",
    "conversation",
    "transcript",
    "subagent",
    "ai"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "claudeChatSearch",
          "title": "Saropa Chat Search",
          "icon": "icon.svg"
        },
        {
          "id": "claudeChatSearchGit",
          "title": "Saropa Git Activity",
          "icon": "gitIcon.svg"
        }
      ]
    },
    "views": {
      "claudeChatSearch": [
        {
          "type": "webview",
          "id": "claudeChatSearch.view",
          "name": "Saropa Chat Search",
          "icon": "icon.svg"
        }
      ],
      "claudeChatSearchGit": [
        {
          "id": "claudeChatSearch.git",
          "name": "Git Activity",
          "icon": "icon.svg"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "claudeChatSearch.git",
        "contents": "No git activity found in your chats yet."
      }
    ],
    "commands": [
      {
        "command": "saropaChatSearch.fileSessions.show",
        "title": "Saropa Chat Search: Show Chats That Touched This File"
      },
      {
        "command": "saropaChatSearch.fileSessions.find",
        "title": "Saropa Chat Search: Find Chats For This File in Search Panel"
      },
      {
        "command": "saropaChatSearch.fileSessions.findEdited",
        "title": "Saropa Chat Search: Find Chats That Edited This File in Search Panel"
      },
      {
        "command": "claudeChatSearch.clearHistory",
        "title": "Saropa Chat Search: Clear Search History"
      },
      {
        "command": "saropaChatSearch.importArchived",
        "title": "Saropa Chat Search: Import Archived Chats from Claude Code"
      },
      {
        "command": "saropaChatSearch.diagnostics",
        "title": "Saropa Chat Search: Show Diagnostics"
      },
      {
        "command": "saropaChatSearch.archive",
        "title": "Archive Chat"
      },
      {
        "command": "saropaChatSearch.unarchive",
        "title": "Unarchive Chat"
      },
      {
        "command": "saropaChatSearch.markRead",
        "title": "Mark as Read"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "saropaChatSearch.fileSessions.show",
          "when": "resourceScheme == file && !explorerResourceIsFolder",
          "group": "saropaChatSearch@1"
        },
        {
          "command": "saropaChatSearch.fileSessions.find",
          "when": "resourceScheme == file && !explorerResourceIsFolder",
          "group": "saropaChatSearch@2"
        },
        {
          "command": "saropaChatSearch.fileSessions.findEdited",
          "when": "resourceScheme == file && !explorerResourceIsFolder",
          "group": "saropaChatSearch@3"
        }
      ],
      "editor/context": [
        {
          "command": "saropaChatSearch.fileSessions.show",
          "when": "resourceScheme == file",
          "group": "saropaChatSearch@1"
        },
        {
          "command": "saropaChatSearch.fileSessions.find",
          "when": "resourceScheme == file",
          "group": "saropaChatSearch@2"
        },
        {
          "command": "saropaChatSearch.fileSessions.findEdited",
          "when": "resourceScheme == file",
          "group": "saropaChatSearch@3"
        }
      ],
      "editor/title/context": [
        {
          "command": "saropaChatSearch.fileSessions.show",
          "when": "resourceScheme == file",
          "group": "saropaChatSearch@1"
        },
        {
          "command": "saropaChatSearch.fileSessions.find",
          "when": "resourceScheme == file",
          "group": "saropaChatSearch@2"
        },
        {
          "command": "saropaChatSearch.fileSessions.findEdited",
          "when": "resourceScheme == file",
          "group": "saropaChatSearch@3"
        }
      ],
      "view/title": [
        {
          "command": "claudeChatSearch.clearHistory",
          "when": "view == claudeChatSearch.view"
        }
      ],
      "webview/context": [
        {
          "command": "saropaChatSearch.archive",
          "when": "webviewId == 'claudeChatSearch.view' && webviewSection == 'chat' && !ccsArchived",
          "group": "saropaChatSearch@1"
        },
        {
          "command": "saropaChatSearch.unarchive",
          "when": "webviewId == 'claudeChatSearch.view' && webviewSection == 'chat' && ccsArchived",
          "group": "saropaChatSearch@1"
        },
        {
          "command": "saropaChatSearch.markRead",
          "when": "webviewId == 'claudeChatSearch.view' && webviewSection == 'chat' && ccsUnread",
          "group": "saropaChatSearch@2"
        }
      ],
      "commandPalette": [
        {
          "command": "saropaChatSearch.archive",
          "when": "false"
        },
        {
          "command": "saropaChatSearch.unarchive",
          "when": "false"
        },
        {
          "command": "saropaChatSearch.markRead",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "Saropa Chat Search",
      "properties": {
        "saropaChatSearch.showFileSessionsStatusBar": {
          "type": "boolean",
          "default": true,
          "description": "Show a status bar count of the Claude chats that touched the active file."
        },
        "saropaChatSearch.maxResults": {
          "type": "number",
          "default": 500,
          "minimum": 50,
          "maximum": 2000,
          "description": "The most chats listed in search results and in All sessions. Chats beyond it are still counted, and the panel says so."
        }
      }
    },
    "colors": [
      {
        "id": "saropaChatSearch.dotRunning",
        "description": "Chat dot: Claude is running.",
        "defaults": {
          "dark": "#89d185",
          "light": "#89d185",
          "highContrast": "#89d185",
          "highContrastLight": "#89d185"
        }
      },
      {
        "id": "saropaChatSearch.dotWaiting",
        "description": "Chat dot: Claude is waiting for you.",
        "defaults": {
          "dark": "#3b82f6",
          "light": "#3b82f6",
          "highContrast": "#3b82f6",
          "highContrastLight": "#3b82f6"
        }
      },
      {
        "id": "saropaChatSearch.dotUnread",
        "description": "Chat dot: finished while you were away.",
        "defaults": {
          "dark": "#d97757",
          "light": "#d97757",
          "highContrast": "#d97757",
          "highContrastLight": "#d97757"
        }
      },
      {
        "id": "saropaChatSearch.dotIdle",
        "description": "Chat dot: idle.",
        "defaults": {
          "dark": "#9d9d9d66",
          "light": "#61616166",
          "highContrast": "#9d9d9d66",
          "highContrastLight": "#61616166"
        }
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p .",
    "prepackage": "node scripts/check_manifest.js",
    "package": "npx @vscode/vsce package --allow-missing-repository --skip-license"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.90.0",
    "typescript": "^5.4.0"
  }
}
